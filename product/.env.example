# Postgres connection string (Neon via Vercel Marketplace in prod, local Postgres in dev)
DATABASE_URL=postgres://localhost:5432/fundraising
# 32 random bytes, base64:  openssl rand -base64 32
FILE_ENCRYPTION_KEY=
# Optional. Turns on the AI layer of the checker (appeal reading, screenshot and document vision).
# Without it the checker runs on rules alone.
ANTHROPIC_API_KEY=
# Optional model override for the checker (default: claude-opus-5-5)
CHECKER_MODEL=
# Optional. Our self-hosted AI-image detector (see detector/server.py). Local only.
DETECTOR_URL=
# Vercel Blob token (needed once document upload is implemented)
BLOB_READ_WRITE_TOKEN=
